/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(145deg, #0b0e1a 0%, #1a1f33 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}
.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.1);
  margin-bottom: 20rpx;
}
.app-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 4rpx;
}

/* 切换标签 */
.tab-bar {
  display: flex;
  width: 100%;
  max-width: 500rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 60rpx;
  padding: 8rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #ffffff;
  border-radius: 60rpx;
  transition: all 0.3s;
}
.tab-item.active {
  background: rgba(108, 92, 231, 0.6);
  color: #ffffff;
  font-weight: 500;
  box-shadow: 0 4rpx 20rpx rgba(108, 92, 231, 0.3);
}

/* 表单 */
.login-form {
  width: 100%;
  max-width: 500rpx;
}
.input-group {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
}
.input-label {
  font-size: 28rpx;
  color: #b2bec3;
  width: 100rpx;
  flex-shrink: 0;
}
.input-field {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: transparent;
  border: none;
  outline: none;
}
.input-field::placeholder {
  color: #636e72;
}

/* 验证码特殊布局 */
.code-group {
  padding-right: 12rpx;
}
.code-input {
  flex: 1;
}
.code-btn {
  flex-shrink: 0;
  width: 180rpx !important;
  height: 64rpx;
  background: rgba(108, 92, 231, 0.4);
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #ffffff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 64rpx;
}
.code-btn[disabled] {
  background: rgba(255,255,255,0.1);
  color: #636e72;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  max-width: 500rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  border-radius: 60rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  border: none;
  margin-top: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(108, 92, 231, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-btn[loading] {
  opacity: 0.7;
}

/* 底部链接 */
.footer-links {
  margin-top: 60rpx;
  display: flex;
  gap: 30rpx;
  font-size: 24rpx;
  color: #636e72;
}